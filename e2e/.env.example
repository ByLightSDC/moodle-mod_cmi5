# Copy this file to e2e/.env and adjust if your setup differs.
# e2e/.env is gitignored; this .example file is committed.

# Base URL of the running Moodle (moodle-docker default).
E2E_BASE_URL=http://localhost:8000

# Postgres connection. Requires the DB port to be exposed to the host:
#   export MOODLE_DOCKER_DB_PORT=15432
#   bin/moodle-docker-compose down && bin/moodle-docker-compose up -d
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=15432
E2E_DB_NAME=moodle
E2E_DB_USER=moodle
E2E_DB_PASSWORD=m@0dl3ing
E2E_DB_PREFIX=m_

# Moodle admin credentials (moodle-docker default is admin / test).
E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=test
