{{!
    @template mod_cmi5/upgrades_review

    The confirmation step: what each selected activity will move to, what it does to learner
    progress, and an explicit confirm.

    The learner-data explanation sits here rather than on the results page because this is the
    last screen before a change that cannot be undone from this interface.

    Context variables required:
    * heading, countlabel, confirmlabel - the headline, the count line and the confirm button
    * rows - each has cmi5id, expectedversionid, targetversionid, activityname, coursename,
      packagetitle, ishidden, hiddenlabel, fromlabel, tolabel, haschanges, hasadded, addedlabel,
      haschanged, changedlabel, hasremoved, removedlabel, changesurl
    * formurl, sesskey, hiddenparams - the confirmation POST
    * backurl - back to the list, with filters intact

    Example context (json):
    {
        "heading": "Review 2 upgrades",
        "countlabel": "2 activities will be upgraded",
        "confirmlabel": "Confirm 2 upgrades",
        "formurl": "#", "sesskey": "abc123", "backurl": "#",
        "rows": [{
            "cmi5id": 3, "expectedversionid": 7, "targetversionid": 9,
            "activityname": "Flight Basics", "coursename": "Pilot Training 2026",
            "packagetitle": "Aviation Safety Fundamentals",
            "fromlabel": "v2", "tolabel": "v4", "haschanges": true,
            "hasadded": true, "addedlabel": "2 units added",
            "haschanged": true, "changedlabel": "5 units updated",
            "hasremoved": true, "removedlabel": "1 unit removed",
            "changesurl": "#"
        }]
    }
}}

<div class="mod-cmi5-library mod-cmi5-upgrades">

    <a href="{{backurl}}" class="mod-cmi5-lib-back">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5"/><path d="M11 19l-7-7 7-7"/></svg>
        {{#str}}upgrade:backtolist, cmi5{{/str}}
    </a>

    <div class="mod-cmi5-lib-head">
        <div class="mod-cmi5-lib-head-text">
            <h2 class="mod-cmi5-lib-title">{{heading}}</h2>
            <p class="mod-cmi5-lib-desc">{{#str}}upgrade:reviewintro, cmi5{{/str}}</p>
        </div>
    </div>

    <div class="mod-cmi5-upg-notice">
        <span class="mod-cmi5-upg-notice-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.5v.5"/></svg>
        </span>
        <div class="mod-cmi5-upg-notice-text">
            <p class="mod-cmi5-upg-notice-title">{{#str}}upgrade:learnerdataheading, cmi5{{/str}}</p>
            <ul class="mod-cmi5-upg-notice-list">
                <li>{{#str}}upgrade:learnerdata_kept, cmi5{{/str}}</li>
                <li>{{#str}}upgrade:learnerdata_retired, cmi5{{/str}}</li>
                <li>{{#str}}upgrade:learnerdata_new, cmi5{{/str}}</li>
                <li>{{#str}}upgrade:learnerdata_noundo, cmi5{{/str}}</li>
            </ul>
        </div>
    </div>

    <div class="mod-cmi5-lib-tree">
        <div class="mod-cmi5-lib-row mod-cmi5-lib-tree-head mod-cmi5-upg-reviewrow">
            <span class="mod-cmi5-upg-cell-main">{{#str}}upgrade:col_activity, cmi5{{/str}}</span>
            <span class="mod-cmi5-upg-cell-version">{{#str}}upgrade:col_version, cmi5{{/str}}</span>
            <span class="mod-cmi5-upg-cell-units">{{#str}}upgrade:col_units, cmi5{{/str}}</span>
            <span class="mod-cmi5-upg-cell-action">{{#str}}upgrade:col_changes, cmi5{{/str}}</span>
        </div>

        {{#rows}}
        <div class="mod-cmi5-lib-row mod-cmi5-upg-reviewrow">
            <div class="mod-cmi5-upg-cell-main">
                <span class="mod-cmi5-upg-activity">
                    {{activityname}}
                    {{#ishidden}}
                    <span class="mod-cmi5-upg-flag">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 3l18 18"/><path d="M10.6 5.1A9.4 9.4 0 0 1 12 5c5 0 9 4.5 10 7-.5 1.2-1.6 2.9-3.3 4.3"/><path d="M6.2 6.8C3.9 8.3 2.4 10.4 2 12c1 2.5 5 7 10 7 1.6 0 3-.4 4.3-1.1"/></svg>
                        {{hiddenlabel}}
                    </span>
                    {{/ishidden}}
                </span>
                <span class="mod-cmi5-upg-course">{{coursename}} &middot; {{packagetitle}}</span>
            </div>
            <div class="mod-cmi5-upg-cell-version">
                <span class="mod-cmi5-upg-current">{{fromlabel}}</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="mod-cmi5-upg-arrow"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg>
                <span class="mod-cmi5-upg-target">{{tolabel}}</span>
            </div>
            <div class="mod-cmi5-upg-cell-units">
                {{#hasadded}}<span class="mod-cmi5-upg-chip is-added">{{addedlabel}}</span>{{/hasadded}}
                {{#haschanged}}<span class="mod-cmi5-upg-chip is-changed">{{changedlabel}}</span>{{/haschanged}}
                {{#hasremoved}}<span class="mod-cmi5-upg-chip is-removed">{{removedlabel}}</span>{{/hasremoved}}
                {{^haschanges}}<span class="mod-cmi5-upg-nochanges">{{#str}}upgrade:changesunavailable, cmi5{{/str}}</span>{{/haschanges}}
            </div>
            <div class="mod-cmi5-upg-cell-action">
                <a href="{{changesurl}}" class="mod-cmi5-btn mod-cmi5-btn-row">{{#str}}upgrade:viewchanges, cmi5{{/str}}</a>
            </div>
        </div>
        {{/rows}}
    </div>

    <form method="post" action="{{formurl}}" class="mod-cmi5-upg-actionbar">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="execute">
        {{#hiddenparams}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hiddenparams}}
        {{#rows}}
        <input type="hidden" name="selected[]" value="{{cmi5id}}">
        <input type="hidden" name="expected[{{cmi5id}}]" value="{{expectedversionid}}">
        <input type="hidden" name="target[{{cmi5id}}]" value="{{targetversionid}}">
        {{/rows}}

        <div class="mod-cmi5-upg-actiontext">
            <p class="mod-cmi5-upg-count">{{countlabel}}</p>
            <p class="mod-cmi5-upg-actionhelp">{{#str}}upgrade:revalidatenotice, cmi5{{/str}}</p>
        </div>
        <a href="{{backurl}}" class="mod-cmi5-btn mod-cmi5-btn-row">{{#str}}back{{/str}}</a>
        <button type="submit" class="mod-cmi5-btn mod-cmi5-btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12.5l5 5L20 6.5"/></svg>
            {{confirmlabel}}
        </button>
    </form>

</div>
