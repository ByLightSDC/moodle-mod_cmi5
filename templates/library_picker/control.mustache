{{!
    @template mod_cmi5/library_picker/control

    Content library package picker control for the activity settings form.

    Shows the current selection and a button that opens the browse modal. The whole
    control is hidden until the mod_cmi5/library_picker AMD module loads, so without
    JavaScript the plain packageid/libraryauid selects remain the only control.

    Context variables required:
    * contextid - course or module context ID for permission checks
    * currentpackageid - package originally linked to the activity, or 0
    * currentversionid - version currently linked to the activity, or 0
    * canclear - bool, whether the current package selection may be cleared
    * inputid - element ID of the form input holding the package ID
    * auinputid - element ID of the form input holding the AU selection
    * perpage - number of cards shown per page in the modal
    * haspackages - bool, the library contains at least one active package
    * total - total number of active packages
    * haslibrarylinks - bool, the activity is already linked to a package the user can manage
    * libraryurl - that package's page in the content library
    * candownloadpackage - bool, the linked version was uploaded as a ZIP
    * downloadurl - that version's original ZIP
    * hasselection - bool
    * selectedtitle - title of the selected package
    * selectedautitle - label describing the selected AU scope
    * initials - one or two letters for the generated tile
    * tone - tile colour tone, 1 to 6
    * modaljson - JSON encoded sort and filter options for the browse modal

    Example context (json):
    {
        "contextid": 42,
        "currentpackageid": 0,
        "currentversionid": 0,
        "canclear": true,
        "inputid": "id_packageid",
        "auinputid": "id_libraryauid",
        "perpage": 9,
        "haspackages": true,
        "total": 12,
        "haslibrarylinks": false,
        "libraryurl": "",
        "candownloadpackage": false,
        "downloadurl": "",
        "hasselection": false,
        "selectedtitle": "",
        "selectedautitle": "",
        "initials": "",
        "tone": 1,
        "modaljson": "{}"
    }
}}
<div class="cmi5-picker cmi5-picker-jshidden" data-region="cmi5-library-picker"
     data-inputid="{{inputid}}" data-auinputid="{{auinputid}}" data-perpage="{{perpage}}">
    {{#haspackages}}
    <div class="cmi5-picker-control">
        <div class="cmi5-picker-selected" data-region="selection" aria-live="polite">
            {{> mod_cmi5/library_picker/selection }}
        </div>
        <div class="cmi5-picker-control-actions">
            <button type="button" class="btn btn-secondary" data-action="browse">
                {{#str}}picker:browse, cmi5{{/str}}
            </button>
            {{#canclear}}
            <button type="button" class="btn btn-link{{^hasselection}} hidden d-none{{/hasselection}}"
                    data-action="clear">
                {{#str}}picker:clear, cmi5{{/str}}
            </button>
            {{/canclear}}
        </div>
    </div>

    {{#haslibrarylinks}}
    {{! Point at the package this activity is linked to now, so they are hidden by the
        picker module as soon as a different package is chosen. }}
    <div class="cmi5-picker-links" data-region="library-links">
        <a href="{{libraryurl}}" class="cmi5-picker-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
            {{#str}}picker:openinlibrary, cmi5{{/str}}
        </a>
        {{#candownloadpackage}}
        <a href="{{downloadurl}}" class="cmi5-picker-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></svg>
            {{#str}}picker:downloadpackage, cmi5{{/str}}
        </a>
        {{/candownloadpackage}}
    </div>
    {{/haslibrarylinks}}
    {{/haspackages}}

    {{^haspackages}}
    <div class="alert alert-info mb-0">{{#str}}picker:nopackages, cmi5{{/str}}</div>
    {{/haspackages}}
</div>
{{#js}}
require(['mod_cmi5/library_picker'], function(picker) {
    picker.init({
        contextId: {{contextid}},
        currentPackageId: {{currentpackageid}},
        currentVersionId: {{currentversionid}},
        inputId: '{{inputid}}',
        auInputId: '{{auinputid}}',
        perPage: {{perpage}},
        total: {{total}},
        modalContext: {{{modaljson}}}
    });
});
{{/js}}
