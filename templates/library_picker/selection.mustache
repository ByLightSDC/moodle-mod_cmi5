{{!
    @template mod_cmi5/library_picker/selection

    The selected package summary shown in the activity settings form.

    Rendered server-side by mod_cmi5\output\library_picker and re-rendered
    client-side by the mod_cmi5/library_picker AMD module after a selection change.

    Context variables required:
    * hasselection - bool
    * selectedtitle - title of the selected package
    * selectedautitle - label describing the selected AU scope
    * initials - one or two letters for the generated tile
    * tone - tile colour tone, 1 to 6

    Example context (json):
    {
        "hasselection": true,
        "selectedtitle": "Fire Safety Basics",
        "selectedautitle": "All AUs (entire package)",
        "initials": "FS",
        "tone": 3
    }
}}
{{#hasselection}}
<span class="cmi5-picker-tile cmi5-picker-tone-{{tone}}" aria-hidden="true">{{initials}}</span>
<span class="cmi5-picker-selected-text">
    <span class="cmi5-picker-selected-title">{{selectedtitle}}</span>
    <span class="cmi5-picker-selected-au">{{selectedautitle}}</span>
</span>
{{/hasselection}}
{{^hasselection}}
<span class="cmi5-picker-tile cmi5-picker-tile-empty" aria-hidden="true">&mdash;</span>
<span class="cmi5-picker-selected-text text-muted">{{#str}}picker:noselection, cmi5{{/str}}</span>
{{/hasselection}}
