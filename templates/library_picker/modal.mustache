{{!
    @template mod_cmi5/library_picker/modal

    Body of the content library browse modal: search and filters, a grid of package
    cards with numbered pagination, and a detail pane that replaces the grid in
    place (rather than opening a second, stacked modal).

    Context variables required:
    * sorts - array of {value, label, selected}
    * sources - array of {value, label, selected}

    Example context (json):
    {
        "sorts": [{"value": "recent", "label": "Recently updated", "selected": true}],
        "sources": [{"value": -1, "label": "All types", "selected": true}]
    }
}}
<div class="cmi5-picker-modal" data-region="picker-modal">

    <div data-region="browse">
        <div class="cmi5-picker-toolbar">
            <div class="cmi5-picker-search">
                <label class="sr-only visually-hidden" for="cmi5-picker-search">
                    {{#str}}picker:searchlabel, cmi5{{/str}}
                </label>
                <input type="text" id="cmi5-picker-search" class="form-control"
                       data-action="search" autocomplete="off"
                       placeholder="{{#str}}picker:searchplaceholder, cmi5{{/str}}">
            </div>
            <div class="cmi5-picker-filter">
                <label class="sr-only visually-hidden" for="cmi5-picker-sort">
                    {{#str}}picker:sortby, cmi5{{/str}}
                </label>
                <select id="cmi5-picker-sort" class="custom-select form-select" data-action="sort">
                    {{#sorts}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/sorts}}
                </select>
            </div>
            <div class="cmi5-picker-filter">
                <label class="sr-only visually-hidden" for="cmi5-picker-source">
                    {{#str}}picker:filtertype, cmi5{{/str}}
                </label>
                <select id="cmi5-picker-source" class="custom-select form-select" data-action="source">
                    {{#sources}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/sources}}
                </select>
            </div>
        </div>

        <div class="cmi5-picker-grid" data-region="cards"></div>

        <div class="cmi5-picker-empty alert alert-info hidden d-none" data-region="empty">
            {{#str}}picker:noresults, cmi5{{/str}}
        </div>

        <div class="cmi5-picker-error alert alert-danger hidden d-none" data-region="error" role="alert">
            {{#str}}picker:loaderror, cmi5{{/str}}
        </div>

        <div class="cmi5-picker-pages" data-region="pages"></div>
    </div>

    <div class="hidden d-none" data-region="detail"></div>
</div>
