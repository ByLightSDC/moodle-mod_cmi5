{{!
    @template mod_cmi5/library

    Content Library list page: the library summary, the filter tabs and one row per course.

    Uses the same shell as mod_cmi5/library_package_detail, so the list and the course it
    opens read as one screen: the summary card, the tab strip and the bordered row container
    are the same components.

    Context variables required:
    * addurl - where "Add a course" goes
    * isempty - the library holds no courses at all
    * packagecount, packagecountlabel - the summary card's headline number and its label
    * hastotals - show the summary facts (false while searching)
    * versionstotal, inuselabel, unusedlabel - the summary facts
    * search, hassearch, searchurl, clearurl - the search form and its current term
    * isalltab, isinusetab, isunusedtab, isupdatestab - which filter is active
    * hasupdatesalert, updatesalert, upgradesurl - the alert above the filters
    * updatescount, tabupdatesurl - the Updates filter
    * taballurl, tabinuseurl, tabunusedurl - filter links
    * allcount, inusecount, unusedcount - filter counts
    * packages - the rows; each has viewurl, title, versionnumber, statusactive, meta,
      usagelabel, hasusage, usageurl, candelete, deleteurl, deleteconfirm, deletelabel, hasupdates,
      updatelabel, updatesurl, hasrepairs, repairlabel, uptodate
    * hasresults - the current filter matched at least one course
    * nomatchestitle, nomatcheshelp - the no-results copy

    Example context (json):
    {
        "addurl": "#",
        "packagecount": 7,
        "packagecountlabel": "courses in the library",
        "hastotals": true,
        "versionstotal": "18 across all courses",
        "inuselabel": "26 activities on 5 courses",
        "unusedlabel": "2 courses can be deleted",
        "searchurl": "#",
        "isalltab": true,
        "taballurl": "#", "tabinuseurl": "#", "tabunusedurl": "#",
        "allcount": 7, "inusecount": 5, "unusedcount": 2,
        "hasresults": true,
        "packages": [
            {"viewurl": "#", "title": "Aviation Safety Fundamentals", "versionnumber": 4,
                "statusactive": true, "meta": "ZIP upload · 4 versions · added 14/08/26 by Dana Whitfield",
                "usagelabel": "6 activities", "hasusage": true, "usageurl": "#", "candelete": false}
        ]
    }
}}

<div class="mod-cmi5-library">

    <div class="mod-cmi5-lib-head">
        <div class="mod-cmi5-lib-head-text">
            <h2 class="mod-cmi5-lib-title">{{#str}}contentlibrary, cmi5{{/str}}</h2>
            <p class="mod-cmi5-lib-desc">{{#str}}library:intro, cmi5{{/str}}</p>
        </div>
        <a href="{{addurl}}" class="mod-cmi5-btn mod-cmi5-btn-tinted">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5"/><path d="M6 11l6-6 6 6"/></svg>
            {{#str}}library:addcourse, cmi5{{/str}}
        </a>
    </div>

    {{^isempty}}
    <section class="mod-cmi5-lib-summary" aria-label="{{#str}}library:librarysummary, cmi5{{/str}}">
        <div class="mod-cmi5-lib-summary-main">
            <p class="mod-cmi5-lib-count">
                <span class="mod-cmi5-lib-count-number" aria-hidden="true">{{packagecount}}</span>
                <span class="mod-cmi5-lib-count-label">{{packagecountlabel}}</span>
            </p>
        
        </div>
        <form method="get" action="{{searchurl}}" class="mod-cmi5-lib-summary-side">
            {{#filter}}<input type="hidden" name="filter" value="{{filter}}">{{/filter}}
            <div class="mod-cmi5-lib-search">
                <label class="mod-cmi5-lib-showing" for="cmi5-lib-search">{{#str}}library:findcourse, cmi5{{/str}}</label>
                <input type="search" id="cmi5-lib-search" name="search" value="{{search}}" class="form-control"
                       placeholder="{{#str}}library:searchplaceholder, cmi5{{/str}}">
            </div>
            <button type="submit" class="mod-cmi5-btn mod-cmi5-btn-row mod-cmi5-lib-search-submit">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>
                {{#str}}library:searchsubmit, cmi5{{/str}}
            </button>
        </form>
    </section>

    {{#hasupdatesalert}}
    <div class="mod-cmi5-lib-updatealert">
        <span class="mod-cmi5-lib-updatealert-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 19V5"/><path d="M6 11l6-6 6 6"/></svg>
        </span>
        <span class="mod-cmi5-lib-updatealert-text">
            <span class="mod-cmi5-lib-updatealert-title">{{updatesalert}}</span>
            <span class="mod-cmi5-lib-updatealert-help">{{#str}}library:updatesalerthelp, cmi5{{/str}}</span>
        </span>
        <a href="{{upgradesurl}}" class="mod-cmi5-btn mod-cmi5-btn-primary">
            {{#str}}library:reviewupgrades, cmi5{{/str}}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg>
        </a>
    </div>
    {{/hasupdatesalert}}

    <nav aria-label="{{#str}}library:libraryfilters, cmi5{{/str}}">
        <ul class="mod-cmi5-tabs">
            <li class="mod-cmi5-tab{{#isalltab}} is-active{{/isalltab}}">
                <a class="mod-cmi5-tab-link" href="{{taballurl}}"{{#isalltab}} aria-current="page"{{/isalltab}}>
                    {{#str}}library:tab_all, cmi5{{/str}}
                    <span class="mod-cmi5-tab-count">{{allcount}}</span>
                </a>
            </li>
            <li class="mod-cmi5-tab{{#isinusetab}} is-active{{/isinusetab}}">
                <a class="mod-cmi5-tab-link" href="{{tabinuseurl}}"{{#isinusetab}} aria-current="page"{{/isinusetab}}>
                    {{#str}}library:tab_inuse, cmi5{{/str}}
                    <span class="mod-cmi5-tab-count">{{inusecount}}</span>
                </a>
            </li>
            <li class="mod-cmi5-tab{{#isunusedtab}} is-active{{/isunusedtab}}">
                <a class="mod-cmi5-tab-link" href="{{tabunusedurl}}"{{#isunusedtab}} aria-current="page"{{/isunusedtab}}>
                    {{#str}}library:tab_unused, cmi5{{/str}}
                    <span class="mod-cmi5-tab-count">{{unusedcount}}</span>
                </a>
            </li>
            <li class="mod-cmi5-tab{{#isupdatestab}} is-active{{/isupdatestab}}">
                <a class="mod-cmi5-tab-link" href="{{tabupdatesurl}}"{{#isupdatestab}} aria-current="page"{{/isupdatestab}}>
                    {{#str}}library:tab_updates, cmi5{{/str}}
                    <span class="mod-cmi5-tab-count">{{updatescount}}</span>
                </a>
            </li>
        </ul>
    </nav>
    {{/isempty}}

    <div class="mod-cmi5-lib-tree mod-cmi5-lib-packages">

        {{#hasresults}}
        <div class="mod-cmi5-lib-row mod-cmi5-lib-tree-head" aria-hidden="true">
            <span class="mod-cmi5-lib-cell-main">{{#str}}library:coursecolumn, cmi5{{/str}}</span>
            <span class="mod-cmi5-lib-cell-usage">{{#str}}library:usagecolumn, cmi5{{/str}}</span>
            <span class="mod-cmi5-lib-cell-updates">{{#str}}library:updatecolumn, cmi5{{/str}}</span>
            <span class="mod-cmi5-lib-cell-rowactions">{{#str}}library:actions, cmi5{{/str}}</span>
        </div>

        {{#packages}}
        <div class="mod-cmi5-lib-row mod-cmi5-lib-package{{^statusactive}} is-disabled{{/statusactive}}">
            <span class="mod-cmi5-lib-cell-main">
                <svg class="mod-cmi5-lib-package-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
                <span class="mod-cmi5-lib-package-body">
                    <span class="mod-cmi5-lib-package-line">
                        <a class="mod-cmi5-lib-package-title" href="{{viewurl}}">{{title}}</a>
                        {{#versionnumber}}
                        <span class="mod-cmi5-lib-chip">v{{versionnumber}}</span>
                        {{/versionnumber}}
                        {{#statusactive}}
                        <span class="mod-cmi5-pill mod-cmi5-status-satisfied">{{#str}}library:status_active, cmi5{{/str}}</span>
                        {{/statusactive}}
                        {{^statusactive}}
                        <span class="mod-cmi5-pill mod-cmi5-status-notstarted">{{#str}}library:status_disabled, cmi5{{/str}}</span>
                        {{/statusactive}}
                    </span>
                    <span class="mod-cmi5-lib-package-meta">{{{meta}}}</span>
                </span>
            </span>
            <span class="mod-cmi5-lib-cell-usage">
                {{#hasusage}}<a href="{{usageurl}}">{{usagelabel}}</a>{{/hasusage}}
                {{^hasusage}}<span class="mod-cmi5-lib-none">{{#str}}library:notused, cmi5{{/str}}</span>{{/hasusage}}
            </span>
            <span class="mod-cmi5-lib-cell-updates">
                {{! A link, not a button: this column reports status, and a link shares a text
                    edge with the plain states beside it. The buttons live under Actions. }}
                {{#hasupdates}}
                <a href="{{updatesurl}}" class="mod-cmi5-lib-updatelink">{{updatelabel}}</a>
                {{/hasupdates}}
                {{#uptodate}}
                <span class="mod-cmi5-lib-none">{{#str}}library:uptodate, cmi5{{/str}}</span>
                {{/uptodate}}
                {{! Nothing uses this course, so there is no update state to report. }}
                {{^hasupdates}}{{^uptodate}}
                <span class="mod-cmi5-lib-none" aria-hidden="true">&mdash;</span>
                {{/uptodate}}{{/hasupdates}}
                {{#hasrepairs}}
                <span class="mod-cmi5-lib-repairflag">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 9v5"/><path d="M12 17.5v.5"/><path d="M10.3 3.9L2.5 18a1.8 1.8 0 0 0 1.6 2.7h15.8A1.8 1.8 0 0 0 21.5 18L13.7 3.9a1.9 1.9 0 0 0-3.4 0z"/></svg>
                    {{repairlabel}}
                </span>
                {{/hasrepairs}}
            </span>
            <span class="mod-cmi5-lib-cell-rowactions">
                <a href="{{viewurl}}" class="mod-cmi5-btn mod-cmi5-btn-row">{{#str}}library:viewdetails, cmi5{{/str}}</a>
                {{! The slot is held open on rows that cannot be deleted, so the button beside
                    it lands in the same place on every row. }}
                {{#candelete}}
                <a href="{{deleteurl}}" class="mod-cmi5-btn mod-cmi5-btn-icon mod-cmi5-btn-danger"
                   data-action="cmi5-confirm" data-confirm="{{deleteconfirm}}"
                   aria-label="{{deletelabel}}" title="{{deletelabel}}">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/><path d="M9 7V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V7"/></svg>
                </a>
                {{/candelete}}
            </span>
        </div>
        {{/packages}}
        {{/hasresults}}

        {{^hasresults}}
        <div class="mod-cmi5-lib-empty">
            <div class="mod-cmi5-lib-empty-inner">
                {{#isempty}}
                <svg class="mod-cmi5-lib-empty-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
                <h3 class="mod-cmi5-lib-empty-title">{{#str}}library:emptyheading, cmi5{{/str}}</h3>
                <p class="mod-cmi5-lib-empty-body">{{#str}}library:emptybody, cmi5{{/str}}</p>
                <div class="mod-cmi5-lib-empty-actions">
                    <a href="{{addurl}}" class="mod-cmi5-btn mod-cmi5-btn-primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5"/><path d="M6 11l6-6 6 6"/></svg>
                        {{#str}}library:uploadcmi5package, cmi5{{/str}}
                    </a>
                    <a href="{{addexternalurl}}" class="mod-cmi5-btn mod-cmi5-btn-row">{{#str}}library:tab_externalau, cmi5{{/str}}</a>
                </div>
                {{/isempty}}
                {{^isempty}}
                <h3 class="mod-cmi5-lib-empty-title">{{nomatchestitle}}</h3>
                <p class="mod-cmi5-lib-empty-body">{{nomatcheshelp}}</p>
                <div class="mod-cmi5-lib-empty-actions">
                    <a href="{{clearurl}}" class="mod-cmi5-btn mod-cmi5-btn-row">{{#str}}library:clearsearch, cmi5{{/str}}</a>
                </div>
                {{/isempty}}
            </div>
        </div>
        {{/hasresults}}

    </div>

    {{#hasresults}}
    <p class="mod-cmi5-lib-footnote">{{#str}}library:listfootnote, cmi5{{/str}}</p>
    {{/hasresults}}

</div>
{{#js}}
require(['mod_cmi5/library_confirm'], function(confirm) {
    confirm.init();
});
{{/js}}
